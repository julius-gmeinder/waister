{
  "manifest_version": 3,
  "name": "Waister",
  "version": "0.1.0",
  "description": "A browser extension written in TypeScript.",
  "action": {
    "default_title": "Waister",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"]
}
